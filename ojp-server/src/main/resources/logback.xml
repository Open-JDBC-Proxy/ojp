<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 
    Configurable properties via system properties or environment variables:
    - ojp.server.logLevel: Root log level (default: INFO)
    - ojp.server.log.file: Log file location (default: logs/ojp-server.log)
    - ojp.server.log.fileNamePattern: Rolling file pattern (default: logs/ojp-server.%d{yyyy-MM-dd}.log)
    - ojp.server.log.maxHistory: Number of days to keep logs (default: 30)
    - ojp.server.log.totalSizeCap: Total size cap for all logs (default: 1GB)
    - ojp.server.log.pattern: Log message pattern (default: %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n)
    - ojp.server.audit.log.path: Audit log file location (default: logs/ojp-audit.log)
    -->
    
    <!-- Console appender for logging to stdout -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${ojp.server.log.pattern:-%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n}</pattern>
        </encoder>
    </appender>

    <!-- File appender for persistent logging -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${ojp.server.log.file:-logs/ojp-server.log}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Daily rollover -->
            <fileNamePattern>${ojp.server.log.fileNamePattern:-logs/ojp-server.%d{yyyy-MM-dd}.log}</fileNamePattern>
            <!-- Keep configured days of history -->
            <maxHistory>${ojp.server.log.maxHistory:-30}</maxHistory>
            <!-- Cap total size -->
            <totalSizeCap>${ojp.server.log.totalSizeCap:-1GB}</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${ojp.server.log.pattern:-%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n}</pattern>
        </encoder>
    </appender>

    <!-- Audit log appender - separate file for audit events -->
    <appender name="AUDIT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${ojp.server.audit.log.path:-logs/ojp-audit.log}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Daily rollover -->
            <fileNamePattern>${ojp.server.audit.log.path:-logs/ojp-audit}.%d{yyyy-MM-dd}.log</fileNamePattern>
            <!-- Keep 90 days of audit history -->
            <maxHistory>90</maxHistory>
            <!-- Cap total size at 5GB for audit logs -->
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <!-- Audit logs use their own formatting, so just output the message -->
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>
    
    <!-- Async appender for audit logs to minimize performance impact -->
    <appender name="ASYNC_AUDIT" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>10000</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="AUDIT_FILE" />
    </appender>

    <!-- Root logger configuration - level is configurable via ojp.server.logLevel -->
    <root level="${ojp.server.logLevel:-INFO}">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

    <!-- Specific logger configurations -->
    <!-- Reduce verbosity of gRPC -->
    <logger name="io.grpc" level="WARN"/>
    
    <!-- Reduce verbosity of Netty -->
    <logger name="io.netty" level="WARN"/>
    
    <!-- OpenTelemetry logging -->
    <logger name="io.opentelemetry" level="INFO"/>
    
    <!-- OJP specific logging - can be adjusted as needed -->
    <logger name="org.openjproxy" level="INFO"/>
    
    <!-- Audit logger - writes to separate audit file -->
    <logger name="AUDIT" level="INFO" additivity="false">
        <appender-ref ref="ASYNC_AUDIT" />
    </logger>
</configuration>
